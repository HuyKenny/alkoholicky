{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local development only (miniflare, local D1/R2).
  "name": "alkoholicky-local",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "alkoholicky-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "RL_GO", "namespace_id": "75001", "simple": { "limit": 40, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "75003", "simple": { "limit": 90, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "local", "SITE_URL": "http://localhost:8796", "ALLOWED_HOSTS": "localhost,127.0.0.1" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "env": {
    "staging": {
      "name": "alkoholicky-staging",
      // alkoholicky-staging.huy-kenny.workers.dev behind Cloudflare Access (whole host); the Worker re-checks the JWT.
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "alkoholicky-staging", "database_id": "66c45d04-f3c7-42b4-8b3c-49d38fbb6a27", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "RL_GO", "namespace_id": "75011", "simple": { "limit": 40, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "75013", "simple": { "limit": 90, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "https://alkoholicky-staging.huy-kenny.workers.dev",
        "ALLOWED_HOSTS": "alkoholicky-staging.huy-kenny.workers.dev",
        "REQUIRE_ACCESS_EVERYWHERE": "1",
        "ANALYTICS_ENABLED": "0",
        "ACCESS_TEAM_DOMAIN": "proud-pine-5d46.cloudflareaccess.com"
      }
      // secrets: ACCESS_AUD, IP_HASH_SALT
    },
    "production": {
      "name": "alkoholicky",
      // Routes alkoholicky.cz/* + www.alkoholicky.cz/* are added at the cutover via the CF API (deleting them = instant rollback).
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "alkoholicky-production", "database_id": "5760b578-8955-42b1-abd7-d29ca423ad83", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "RL_GO", "namespace_id": "75021", "simple": { "limit": 40, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "75023", "simple": { "limit": 90, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://alkoholicky.cz",
        "ALLOWED_HOSTS": "alkoholicky.cz,www.alkoholicky.cz,alkoholicky.huy-kenny.workers.dev",
        "REQUIRE_ACCESS_EVERYWHERE": "0",
        "ANALYTICS_ENABLED": "1"
      }
    }
  }
}

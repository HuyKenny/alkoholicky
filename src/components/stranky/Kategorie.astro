---
// Product category: listing + the blocks the WordPress mu-plugins printed under it (page 1 only): TOP 8 comparison
// table (ah-seo.php), buying guide (term meta ah_guide), FAQ (ah_faq → FAQPage in views.ts), gift-guide box, second text.
import Base from '../../layouts/Base.astro';
import Vypis from './Vypis.astro';
import type { categoryView } from '../../lib/views';
import { cena, decode, texturize } from '../../lib/format';
import { catIcon } from '../../lib/ikony';

interface Props { v: Exclude<NonNullable<Awaited<ReturnType<typeof categoryView>>>, { redirect: string }> }
const { v } = Astro.props;
const m = v.meta;
const first = v.page === 1 && !v.isFiltered;
const tiles = v.kids.map((c) => ({ slug: c.slug, name: decode(c.name), count: c.count_total, img: v.imgs[String(c.id)] }));
const name = decode(v.cat.name);
// alcohol strength and volume from the product name ("… 0,7l 40%"), like the WordPress table
const abv = (t: string) => (/(\d{1,2}(?:[.,]\d)?)\s*%/.exec(t)?.[1] ?? '').replace('.', ',');
const vol = (t: string) => (/(\d(?:[.,]\d+)?)\s*l\b/i.exec(t)?.[1] ?? '').replace('.', ',');
const top = first ? v.items.slice(0, 8) : [];
---
<Base title={m.title} description={m.description} canonical={m.canonical} prev={m.prev} next={m.next} robots={m.robots} graph={m.graph} jsonLd={m.jsonLd} shortOrg={m.shortOrg} pageType="category">
	<Vypis crumbs={v.crumbs} h1={name} icon={catIcon(v.cat.slug, v.tree)} introHtml={first ? v.cat.description_html : undefined} tiles={tiles} tilesTitle={v.kidsTitle}
		f={v.f} fc={v.fc} brands={v.brands} landings={v.landings} items={v.items} total={v.total} page={v.page} pages={v.pages} base={v.base} qs={v.qs}
		empty="V této kategorii teď nejsou žádné produkty.">
		{v.gift && (
			<div class="sek box ah-gift-guides"><strong>Hledáte dárky na Vánoce?</strong> <a class="lnk" href="/firemni-vanocni-darky-s-alkoholem/">Firemní vánoční dárky s alkoholem podle rozpočtu</a> · <a class="lnk" href="/adventni-kalendar-s-alkoholem/">Adventní kalendáře s alkoholem</a></div>
		)}
		{top.length >= 3 && (
			<section class="sek ah-ctable">
				<h2>TOP {name} – srovnání cen</h2>
				<div class="tw"><table class="ct">
					<thead><tr><th>#</th><th>Produkt</th><th>Obsah alk.</th><th>Objem</th><th>Cena od</th><th></th></tr></thead>
					<tbody>{top.map((p, i) => { const n = decode(p.name); return (
						<tr><td>{i + 1}</td><td><a href={`/${p.slug}/`}>{texturize(n)}</a></td><td>{abv(n) ? abv(n) + ' %' : '—'}</td><td>{vol(n) ? vol(n) + ' l' : '—'}</td>
						<td class="num">{p.min_price > 0 ? 'od ' + cena(p.min_price) : '—'}</td><td><a class="btn btn--g" href={`/${p.slug}/`}>Porovnat ceny</a></td></tr>
					); })}</tbody>
				</table></div>
				<p class="pozn">Ceny porovnáváme z více než 20 e-shopů a aktualizujeme je denně. Pořadí dle oblíbenosti.</p>
			</section>
		)}
		{v.guide && <section class="sek txt ah-guide" set:html={v.guide} />}
		{v.faq.length > 0 && (
			<section class="sek faq ah-faq">
				<h2>Často kladené dotazy</h2>
				{v.faq.map((f) => <details><summary>{f.q}</summary><div set:html={f.a} /></details>)}
			</section>
		)}
		{first && v.cat.second_html && <section class="sek txt" set:html={v.cat.second_html} />}
	</Vypis>
</Base>

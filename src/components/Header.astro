---
// Header: logo, mega menu (one markup: desktop dropdown / mobile full screen, <details> works without JS), search with
// suggestions (/api/suggest, src/scripts/ui.ts) and a row of the main categories. Menu = data/menu.json (27. 10. 2026:
// the WordPress main menu, scripts/migrate-from-wp.py; a group with url '' has no link).
import Ik from './Ik.astro';
import Logo from './Logo.astro';
import { catIcon, ikona } from '../lib/ikony';
import menu from '../data/menu.json';

interface Item { id: number; parent: number; title: string; url: string; order: number }
const items = (menu as Item[]).slice().sort((a, b) => a.order - b.order);
// top-level items without children (the WordPress "Magazín" link) live in the hand-made Rádce group instead
const tree = items.filter((i) => i.parent === 0).map((i) => ({ it: i, kids: items.filter((k) => k.parent === i.id) })).filter((n) => n.kids.length > 0);
const QUICK: Array<[string, string, string]> = [
	['/whisky-a-ochucene-whisky/', 'Whisky', 'whisky'], ['/rumy-a-ochucene-rumy/', 'Rum', 'rum'], ['/giny/', 'Gin', 'gin'], ['/vodky-a-ochucene-vodky/', 'Vodka', 'vodka'],
	['/likery/', 'Likéry', 'likery'], ['/konaky/', 'Koňak', 'konak'], ['/tequily/', 'Tequila', 'tequila'], ['/vina/', 'Víno', 'vino'],
	['/sumiva-a-perliva-vina/', 'Bublinky', 'sumive'], ['/piva/', 'Pivo', 'pivo'], ['/miniatury-alkoholu/', 'Miniatury', 'miniatury'], ['/nealko/', 'Nealko', 'nealko'],
	['/darky-z-alkohol-cz/', 'Dárky', 'darky'],
];
const q = (Astro.url.searchParams.get('s') ?? '').trim().toLowerCase();
---
<a class="skip" href="#obsah">Přeskočit na obsah</a>
<div class="usp"><ul><li>Srovnáváme 20+ e-shopů s alkoholem</li><li>Ceny aktualizujeme každý den</li><li>Kupujete přímo u obchodu, za stejnou cenu</li><li>Jen pro 18+</li></ul></div>
<header class="hl">
	<div class="w hl__in">
		<details class="mm">
			<summary aria-label="Kategorie"><Ik id="menu" size={22} /><span class="mm__t">Kategorie</span></summary>
			<nav class="mm__p" aria-label="Kategorie">
				<div class="mm__top"><b>Kategorie</b><span class="mm__x" data-zavrit aria-label="Zavřít"><Ik id="zavrit" size={22} /></span></div>
				<div class="mm__g">
					{tree.map((n) => (
						<div class="mm__sk">
							{n.it.url ? <a href={n.it.url}>{catIcon(n.it.url.replace(/\//g, '')) && <img src={catIcon(n.it.url.replace(/\//g, ''))!.replace('/ik/', '/ik/s/')} alt="" width="30" height="30" loading="lazy" />}{n.it.title.replace(/^[^\p{L}]+/u, '')}</a> : <b>{n.it.title}</b>}
							{n.kids.length > 0 && <ul>{n.kids.map((k) => <li><a href={k.url}>{k.title}</a></li>)}</ul>}
						</div>
					))}
					<div class="mm__sk"><a href="/blog/">Rádce a magazín</a><ul><li><a href="/alkohol-kalkulacka/">Alkohol kalkulačka</a></li><li><a href="/leky-a-alkohol/">Léky a alkohol</a></li><li><a href="/adventni-kalendare/">Adventní kalendáře</a></li><li><a href="/firemni-vanocni-darky-s-alkoholem/">Firemní dárky</a></li></ul></div>
				</div>
			</nav>
		</details>
		<Logo label="Alkoholický.cz — srovnání cen alkoholu" />
		<div class="hs">
			<form class="hs__f" role="search" method="get" action="/" autocomplete="off">
				<label class="vh" for="hs-q">Hledat produkt, značku nebo kategorii</label>
				<Ik id="hledat" />
				<input type="search" id="hs-q" name="s" value={q} placeholder="Hledat produkt, značku, kategorii…" data-suggest aria-autocomplete="list" aria-controls="hs-s" enterkeyhint="search" />
				<button type="submit">Hledat</button>
			</form>
			<div class="hs__s" id="hs-s" role="listbox" hidden></div>
		</div>
		<div class="hl__akce">
			<a class="hl__a" href="/lihoviny/?orderby=disc" rel="nofollow"><img src={ikona('akce', true)} alt="" width="28" height="28" /><span>Akce</span></a>
			<a class="hl__a" href="/alkohol-kalkulacka/"><img src={ikona('kalkulacka', true)} alt="" width="28" height="28" /><span>Kalkulačka</span></a>
			<a class="hl__a" href="/blog/"><img src={ikona('magazin', true)} alt="" width="28" height="28" /><span>Magazín</span></a>
		</div>
	</div>
	<nav class="kn" aria-label="Hlavní kategorie">
		<ul>{QUICK.map(([u, t, i]) => <li><a href={u}><img src={ikona(i, true)} alt="" width="40" height="40" />{t}</a></li>)}</ul>
	</nav>
</header>
